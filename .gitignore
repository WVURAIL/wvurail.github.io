# Jekyll build output (GitHub builds this for you — never commit it)
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Ruby / Bundler
vendor/
.bundle/
# Written by .github/workflows/build.yml, and by hand for a local build against
# the same gems Pages runs. Never committed: a stale copy would shadow CI's.
Gemfile.ci
Gemfile.ci.lock

# OS / editor cruft
.DS_Store
Thumbs.db
*Zone.Identifier

# Python bytecode, from running the checks in .github/scripts/ locally
__pycache__/
*.py[cod]
